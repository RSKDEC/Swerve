.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":1701646,"filename":"CL24_25_Q1_online_questionnaire_v4__Clean_.docx.pdf","id":"9422509","isbn":"","number_of_pages":78,"title":"Community Life Survey 2024/25: Appendix A - Online questionnaire","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/693047dd502f392086ee8b47/CL24_25_Q1_online_questionnaire_v4__Clean_.docx.pdf"},{"accessible":false,"alternative_format_contact_email":"enquiries@dcms.gov.uk","assets":[{"asset_manager_id":"693047f5502f392086ee8b49","filename":"Community_Life_Questionnaire_2024_Verian_R1_PROOF.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":254280,"filename":"Community_Life_Questionnaire_2024_Verian_R1_PROOF.pdf","id":"9422510","isbn":"","number_of_pages":23,"title":"Community Life Survey 2024/25: Appendix B - Paper questionnaire","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/693047f5502f392086ee8b49/Community_Life_Questionnaire_2024_Verian_R1_PROOF.pdf"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9422511","isbn":"","title":"Community Life Survey 2024/25: Appendix D - Derived variables","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/statistics/community-life-survey-202425-annual-publication/community-life-survey-202425-appendix-d-derived-variables"},{"accessible":false,"alternative_format_contact_email":"enquiries@dcms.gov.uk","assets":[{"asset_manager_id":"6932cef45b5198836f30411f","filename":"CLS24-25_Invite_Letter.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":210083,"filename":"CLS24-25_Invite_Letter.pdf","id":"9422512","isbn":"","number_of_pages":2,"title":"Community Life Survey 2024/25: Appendix C - Example invitation letter","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/6932cef45b5198836f30411f/CLS24-25_Invite_Letter.pdf"},{"attachment_type":"html","command_paper_number":"","hoc_paper_number":"","id":"9422513","isbn":"","title":"Community Life Survey 2024/25: Pre-release access","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"/government/statistics/community-life-survey-202425-annual-publication/community-life-survey-202425-pre-release-access"}],"body":"<div class=\"govspeak\"><div class=\"call-to-action\">\n  <p><strong>Correction to sexual orientation and socio-economic classification data</strong>: A correction has been made to the 2024/25 estimates for sexual orientation and socioeconomic classification. In this release, a mixed weight was applied to these variables instead of a web-only weight in error. The corrected 2024/25 figures are available in the <a rel=\"external\" href=\"https://gov.uk/guidance/community-and-engagement-survey-202526\">2025/26 Annual Community and Engagement Survey release</a>, which show a small difference compared to the estimates presented here. Users are advised to use the updated figures in the CES release.</p>\n</div>\n\n<p>The Community Life Survey is a nationally representative annual survey of adults (16+) in England that tracks the latest trends and developments across areas that are key to encouraging social action and empowering communities. Data collection on the Community Life Survey commenced in 2012/13 using a face-to-face format. During the survey years from 2013/14 to 2015/16 a push-to-web format was tested, which included collecting online/paper data alongside the face-to-face data, before moving fully to a push-to-web format in 2016/17. The results included in this release are based on online/paper completes only, covering the survey years from 2013/14, when this method was first tested, to 2024/25.</p>\n\n<div class=\"call-to-action\">\n  <ul>\n    <li>\n      <p>Released: 10 December 2025</p>\n    </li>\n    <li>\n      <p>Period covered: October 2024 to March 2025</p>\n    </li>\n    <li>\n      <p>Geographic coverage: National, regional and local authority level data for England.</p>\n    </li>\n  </ul>\n</div>\n\n<p>In 2023/24 and 2024/25, DCMS partnered with the Ministry of Housing, Communities and Local Government (MHCLG) to boost the Community Life Survey to be able to produce meaningful estimates at the local authority level. This has enabled us to have the most granular data we have ever had. The questionnaire for 2023/24 and 2024/25 has been developed collaboratively to adapt to the needs and interests of both DCMS and MHCLG, and there were some new questions and changes to existing questions, response options and definitions in the 2023/24 and 2024/25 surveys.</p>\n\n<p>Fieldwork for 2024/25 was delivered over two quarters (October to December 2024 and January to March 2025) in line with delivery of the 2023/24 survey. As such there are two quarterly publications in 2024/25, in addition to this annual publication, which covers the period of October 2024 to March 2025.</p>\n\n<p>The pre-release access list above contains the ministers and officials who have received privileged early access to this release of Community Life Survey data. In line with best-practice, the list has been kept to a minimum and those given access for briefing purposes had a maximum of 24 hours. Details on the pre-release access arrangements for this dataset are available in the accompanying material.</p>\n\n<p>Our statistical practice is regulated by the Office for Statistics Regulation (OSR). OSR sets the standards of trustworthiness, quality and value in the Code of Practice for Statistics that all producers of official statistics should adhere to.</p>\n\n<div role=\"note\" aria-label=\"Information\" class=\"application-notice info-notice\">\n  <p>In 2024/25 we collected data on the respondent’s sex and gender identity, with question wording taken from the Census 2021. Please note that patterns were identified in Census 2021 data that suggest that some respondents may not have interpreted the gender identity question as intended, notably those with lower levels of English language proficiency. <a rel=\"external\" href=\"https://www.scotlandscensus.gov.uk/2022-reports/scotland-s-census-2022-sexual-orientation-and-trans-status-or-history/\">Analysis of Scotland’s census,</a> where the gender identity question was different, has added weight to this observation. Similar respondent error may have occurred during the data collection for these statistics so comparisons between subnational and other smaller group breakdowns should be considered with caution. More information can be found in the <a rel=\"external\" href=\"https://www.ons.gov.uk/peoplepopulationandcommunity/culturalidentity/sexuality/methodologies/sexualorientationandgenderidentityqualityinformationforcensus2021\">ONS sexual orientation and gender identity quality information report,</a> and in the National Statistical <a rel=\"external\" href=\"https://blog.ons.gov.uk/2024/09/12/better-understanding-the-strengths-and-limitations-of-gender-identity-statistics/\">blog about the strengths and limitations of gender identity statistics</a>.</p>\n</div>\n\n<p>You are welcome to contact us directly with any comments about how we meet these standards by emailing evidence@dcms.gov.uk. Alternatively, you can contact OSR by emailing regulation@statistics.gov.uk or via the OSR website.</p>\n\n<p>The responsible analyst for this release is Rebecca Wyton. For enquiries on this release, contact communitylifesurvey@dcms.gov.uk</p>\n</div>","change_history":[{"note":"A correction has been made to the 2024/25 estimates for sexual orientation and socio-economic classification. The corrected 2024/25 figures are available in the 2025/26 Annual Community and Engagement Survey release (linked on this page), which show a small difference compared to the estimates presented here. Users are advised to use the updated figures in the CES release.","public_timestamp":"2026-07-31T08:30:06Z"},{"note":"Added hyperlinks","public_timestamp":"2025-12-10T10:02:51Z"},{"note":"First published.","public_timestamp":"2025-12-10T09:30:00Z"}],"document_type_label":"Official Statistics","emphasised_organisations":["ae9ef2e1-9de0-4ff8-b560-e6ac28a6205c","04efa5ed-5a59-40e2-be02-fbf105c94794"],"featured_attachments":["9422501","9422502","9422503","9422504","9422505","9422506","9422507","9422508","9422509","9422510","9422511","9422512","9422513"],"first_public_at":"2025-12-10T09:30:00.000+00:00","national_applicability":{"england":{"applicable":true,"label":"England"},"northern_ireland":{"alternative_url":"","applicable":false,"label":"Northern Ireland"},"scotland":{"alternative_url":"","applicable":false,"label":"Scotland"},"wales":{"alternative_url":"","applicable":false,"label":"Wales"}},"political":false,"tags":{"browse_pages":[]}},"document_type":"official_statistics","first_published_at":"2025-12-10T09:30:00+00:00","links":{"available_translations":[{"api_path":"/api/content/government/statistics/community-life-survey-202425-annual-publication","api_url":"https://www.gov.uk/api/content/government/statistics/community-life-survey-202425-annual-publication","base_path":"/government/statistics/community-life-survey-202425-annual-publication","content_id":"74ff4787-3be0-4cbf-99e9-c299ccfb6408","document_type":"official_statistics","links":{},"locale":"en","public_updated_at":"2026-07-31T08:30:06Z","schema_name":"publication","title":"Community Life Survey 2024/25 annual publication","web_url":"https://www.gov.uk/government/statistics/community-life-survey-202425-annual-publication","withdrawn":false}],"children":[{"api_path":"/api/content/government/statistics/community-life-survey-202425-annual-publication/community-l